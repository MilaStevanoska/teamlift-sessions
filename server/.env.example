# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@localhost:5432/teamlift"

# Port the API listens on
PORT=3000

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN="http://localhost:5173"

# Optional: free key from https://aistudio.google.com/apikey
# Without it, Teamo falls back to a friendly template message.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
